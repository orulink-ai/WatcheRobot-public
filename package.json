{
  "name": "watcherobot-public-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test wiki/tests/*.test.mjs",
    "docs:prepare": "node wiki/content.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev wiki",
    "docs:build": "npm run docs:prepare && vitepress build wiki",
    "docs:preview": "vitepress preview wiki",
    "check": "npm test && npm run docs:build",
    "wiki:update": "node wiki/dispatch.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "vitepress": "2.0.0-alpha.19"
  }
}
